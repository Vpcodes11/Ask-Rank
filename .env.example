# ==========================================
# ASKRANK DEPLOYMENT CONFIGURATION
# ==========================================

# Port (Defaults to 3000 in production, or assigned by host e.g. Railway/Heroku/Render)
PORT=3000

# Base URL for canonical OpenGraph tags & sitemaps (Optional)
NEXT_PUBLIC_APP_URL=https://askrank.ai

# ==========================================
# OPTIONAL LIVE AI API KEYS
# When provided, AskRank calls live search-grounded APIs.
# Without them, AskRank automatically runs high-fidelity grounded simulations.
# ==========================================

# Perplexity AI Sonar API Key
PERPLEXITY_API_KEY=

# OpenAI API Key (GPT-4o with search grounding)
OPENAI_API_KEY=

# Google Gemini API Key (Gemini 2.0 with Google Search Grounding)
GEMINI_API_KEY=
