# Copy to .env (local) or add in Vercel → Project → Settings → Environment Variables.
# Everything marked REQUIRED must be set for production.

# --- App ----------------------------------------------------------------
# REQUIRED. Your live address, no trailing slash (used in emails, checkout return links, share cards)
APP_URL=https://askrank.ai
# REQUIRED. Long random string that signs login cookies. Generate: openssl rand -hex 32
AUTH_SECRET=
# Shown on Privacy/Terms/footer
NEXT_PUBLIC_COMPANY_NAME=AskRank
NEXT_PUBLIC_SUPPORT_EMAIL=support@askrank.ai

# --- Database (Neon Postgres) ---------------------------------------------
# REQUIRED. The Vercel ↔ Neon integration sets both automatically.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- AI engines -----------------------------------------------------------
# At least ONE is REQUIRED. Each key you add switches on that engine. No key = no engine
# (there is no simulated fallback). OpenAI or Gemini is also used to write buyer prompts,
# read answers and draft content fixes.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# OPENAI_SEARCH_MODEL=gpt-4.1-mini
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# PERPLEXITY_MODEL=sonar
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# Optional: only use some engines, e.g. to save cost: openai_search,perplexity,gemini_grounding
# ENABLED_ENGINES=

# --- Cost controls (defaults shown) ---------------------------------------
# FREE_SCANS_PER_DAY=150          # all visitors combined
# FREE_SCANS_PER_IP_PER_DAY=3
# PAID_SCANS_PER_DAY=30           # per paying customer
# FREE_SCAN_CACHE_HOURS=24        # same store re-scanned within this window reuses the result

# --- Email (Resend) -------------------------------------------------------
# REQUIRED in production (sign-in links, receipts, weekly digests)
RESEND_API_KEY=
# Must be on a domain you verified in Resend
EMAIL_FROM=AskRank <hello@askrank.ai>
# EMAIL_REPLY_TO=support@askrank.ai

# --- Payments (Dodo Payments) ---------------------------------------------
# REQUIRED to take money. test_mode while testing, live_mode when live.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Product IDs from the Dodo dashboard. _INR ones are optional (Indian buyers fall back to USD).
DODO_PRODUCT_REPORT_USD=
DODO_PRODUCT_REPORT_INR=
DODO_PRODUCT_MONITOR_USD=
DODO_PRODUCT_MONITOR_INR=
DODO_PRODUCT_AGENCY_USD=
DODO_PRODUCT_AGENCY_INR=

# --- Weekly monitor cron ----------------------------------------------------
# REQUIRED. Vercel sends it automatically to /api/cron/weekly. Generate: openssl rand -hex 32
CRON_SECRET=
# Stores run in parallel per cron call (default 4)
# CRON_PARALLEL=4
